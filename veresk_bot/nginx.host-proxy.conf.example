# Пример: nginx/Caddy на хосте с Let's Encrypt, Docker слушает только :3005.
# Скопируйте в /etc/nginx/sites-available/admin.veresk-flowers.ru и включите сайт.
#
#   certbot --nginx -d admin.veresk-flowers.ru
#   # или сначала webroot, затем раскомментируйте ssl-блок
#
# Docker: docker compose up -d  (порт 3005:3005 уже в docker-compose.yml)

upstream veresk_bot {
    server 127.0.0.1:3005;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.veresk-flowers.ru;

    # ACME (certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.veresk-flowers.ru;

    # После certbot пути обычно такие:
    ssl_certificate     /etc/letsencrypt/live/admin.veresk-flowers.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.veresk-flowers.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 200m;

    location / {
        proxy_pass http://veresk_bot;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Telegram-Init-Data $http_x_telegram_init_data;
        proxy_set_header Authorization $http_authorization;
        # SSE (чаты MAX в админке)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }
}
