BOT_TOKEN=1234567890:ABCDEFghijklmnopQRSTUVwxyz
# Уведомления флористу в Telegram (анкета, заказы). По умолчанию выключено.
FLORIST_NOTIFICATIONS_ENABLED=false
# FLORIST_CHAT_ID=123456789
POSIFLORA_USERNAME=admin@veresk.ru
POSIFLORA_PASSWORD=ваш_пароль
POSIFLORA_STORE_ID=12345
# URL API вашего салона (не demo, если заказы в боевой Posiflora)
POSIFLORA_BASE_URL=https://demo.posiflora.com/api

# --- posiflora_customer_event.py (ручной тест интеграции) ---
# POSIFLORA_BASE_URL=https://veresksalon.posiflora.com/api/v1
# CUSTOMER_PHONE=+79001234567
# CUSTOMER_FIRST_NAME=Иван
# CUSTOMER_RECIPIENT=Мария
# CUSTOMER_RELATION=Жена
# EVENT_OCCASION=День рождения
# CUSTOMER_BUDGET=до 10 000 ₽
# CUSTOMER_DELIVERY_DATE=Завтра

# Redis (опционально — если не указан, используется MemoryStorage)
REDIS_URL=redis://redis:6379

# Интервал проверки статусов заказов (секунды, по умолчанию 60)
POLL_INTERVAL=60

# --- Публичный домен (продакшен) ---
PUBLIC_BASE_URL=https://admin.veresk-flowers.ru
# Telegram Mini App — публичный HTTPS-URL (обязателен, со слэшем в конце)
MINIAPP_URL=https://admin.veresk-flowers.ru/miniapp/
WEBAPP_PORT=3005
WEBAPP_HOST=0.0.0.0
# Админка: https://admin.veresk-flowers.ru/admin/

# SQLite: клиенты и история заказов (в Docker: /app/data/veresk.db)
DATABASE_PATH=/app/data/veresk.db

# --- Админ-панель рассылок (/admin/) ---
# Логин и пароль для входа
ADMIN_USERNAME=admin
ADMIN_PASSWORD=смените_на_сложный_пароль
# Устарело: если ADMIN_PASSWORD пуст, используется как пароль
# ADMIN_TOKEN=
# Интервал синхронизации клиентов из Posiflora (секунды, по умолчанию 1 час)
POSIFLORA_SYNC_INTERVAL=3600
# Пауза между сообщениями рассылки (секунды) и размер пачки
MAILING_SEND_INTERVAL=3.0
MAILING_BATCH_SIZE=10
# Подстановка для плейсхолдера {скидка} в текстах рассылок
MAILING_DISCOUNT_TEXT=15%

# Telethon: API ID/Hash с https://my.telegram.org (для отправки с личных номеров).
# Необязательно: можно задать прямо в админ-панели (вкладка «Аккаунты» → «Ключи Telegram API»).
# Значения из панели имеют приоритет над этими.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Папка сессий Telethon
SESSIONS_DIR=/app/data/sessions

# MAX-бот (токен выдаёт @MasterBot в мессенджере MAX).
# Необязательно: можно задать прямо в админ-панели (вкладка «Аккаунты» → «MAX-бот»).
# Значение из панели имеет приоритет над этим.
MAX_BOT_TOKEN=
# ID чата флориста в MAX для уведомлений об анкетах (0 или пусто — выключено)
MAX_FLORIST_CHAT_ID=
# База MAX Bot API (по умолчанию platform-api2.max.ru)
# MAX_API_BASE=https://platform-api2.max.ru
# Webhook для realtime-чатов и анкеты (HTTPS :443). При активной подписке
# long polling у max_bot отключается — события принимает bot-сервис.
MAX_WEBHOOK_URL=https://admin.veresk-flowers.ru/api/max/webhook
# Секрет заголовка X-Max-Bot-Api-Secret (5–256: A-Z a-z 0-9 _ -)
MAX_WEBHOOK_SECRET=change_me_to_long_random
# URL уведомления SSE-хаба из контейнера max_bot (long polling → админка)
MAX_HUB_NOTIFY_URL=http://bot:3005/api/internal/max/event

# --- ИИ-редактор текстов рассылок ---
# Удобнее в админке: Настройки → Сервисы → ИИ-редактор (приоритет выше .env).
# Операторы: openai | openrouter | yandexgpt | custom
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-...
# AI_MODEL=openai/gpt-4o-mini
# Для YandexGPT:
# AI_PROVIDER=yandexgpt
# AI_API_KEY=AQVN...
# AI_FOLDER_ID=b1g...
# AI_MODEL=yandexgpt-lite/latest
# Альтернативы: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL, YANDEX_FOLDER_ID
